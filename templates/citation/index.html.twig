{% extends 'base.html.twig' %}

{% block title %}Bibliothèque{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Bibliothèque de citations</h1>
            {% if citations is not empty %}
                <p class="text-muted mb-0">{{ citations|length }} citation{{ citations|length > 1 ? 's' }} enregistrée{{ citations|length > 1 ? 's' }}</p>
            {% endif %}
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_citation_new') }}" class="btn btn-primary">Ajouter</a>
            {% if citations is not empty %}
                <a href="{{ path('app_citation_export_csv') }}" class="btn btn-outline-secondary">Export CSV</a>
            {% endif %}
        </div>
    </div>

    {% if citations is empty %}
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-5">
                <h2 class="h4">Aucune citation pour le moment</h2>
                <p class="text-muted">Ajoutez-en une pour commencer votre bibliothèque.</p>
                <a href="{{ path('app_citation_new') }}" class="btn btn-primary">Ajouter ma première citation</a>
            </div>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-lg-2 g-3">
            {% for citation in citations %}
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm citation-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge text-bg-secondary">{{ citation.categorie|capitalize }}</span>
                                <span class="badge text-bg-light border">{{ citation.langue|upper }}</span>
                                {% if citation.favori %}
                                    <span class="badge text-bg-warning">Favori</span>
                                {% endif %}
                            </div>

                            <blockquote class="blockquote mb-2">
                                <p class="citation-texte mb-2">« {{ citation.texte }} »</p>
                                <footer class="blockquote-footer mt-0">{{ citation.auteur }}</footer>
                            </blockquote>

                            <div class="d-flex flex-wrap align-items-center gap-2 text-muted small mt-auto mb-3">
                                <span>Ajoutée le {{ citation.dateAjout|date('d/m/Y') }}</span>
                                {% if citation.note %}
                                    <span class="note-etoiles" title="Note : {{ citation.note }}/5">{% for i in 1..5 %}{{ i <= citation.note ? '★' : '☆' }}{% endfor %}</span>
                                {% endif %}
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_citation_show', {id: citation.id}) }}">Consulter</a>
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_citation_edit', {id: citation.id}) }}">Modifier</a>
                                {{ include('citation/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
