<form method="post" action="{{ path('app_citation_delete', {id: citation.id}) }}" class="d-inline"
      onsubmit="return confirm('Voulez-vous vraiment supprimer cette citation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ citation.id) }}">
    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
</form>